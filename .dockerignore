# Keep the build context small and free of anything that must not reach an image.
# A smaller context also means faster builds and a cleaner Trivy scan surface.

.git
.github
.venv
venv
__pycache__
*.py[cod]
*.egg-info

# Data and models — the API image pulls its model at build or boot, never
# from the build context.
data/
models/
mlruns/
mlartifacts/
*.csv
*.parquet
*.pkl
*.joblib

# Secrets
.env
.env.*
!.env.example
.secrets.baseline

# Dev-only
notebooks/
tests/
loadtest/
docs/
reports/
logs/
grafana-data/
prometheus-data/
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
.pre-commit-config.yaml
.vscode
.idea
