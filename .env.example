# =============================================================================
# Copy to .env and edit. .env is gitignored and must NEVER be committed.
#
#   cp .env.example .env
#
# Every variable here is optional — configs/*.yaml supplies working defaults.
# These exist to override without editing tracked files.
#
# Naming: MLSERVICE_ prefix, __ for nesting. So api.port becomes
# MLSERVICE_API__PORT. A mistyped NESTED key fails validation loudly; a
# mistyped ROOT key is silently ignored, so run `uv run mlservice doctor`
# after editing — it reports unrecognised variables.
# =============================================================================

# --- Environment -------------------------------------------------------------
# local | hf | test   (anything else refuses to start)
MLSERVICE_ENV=local

# --- Logging -----------------------------------------------------------------
# MLSERVICE_LOGGING__LEVEL=INFO
# console is readable locally; json is what actually ships
# MLSERVICE_LOGGING__FORMAT=console

# --- API ---------------------------------------------------------------------
# MLSERVICE_API__PORT=8000
# MLSERVICE_API__WORKERS=1

# --- MLflow ------------------------------------------------------------------
# Inside compose the API reaches MLflow by service name (http://mlflow:5000).
# Running the API directly on the host instead? Use localhost:
# MLSERVICE_MLFLOW__TRACKING_URI=http://localhost:5000

# --- Compose -----------------------------------------------------------------
# Pinned because this checkout lives in a directory whose name contains spaces
# and parentheses; Docker derives the project name from the directory otherwise
# and produces invalid resource names.
COMPOSE_PROJECT_NAME=production-ml-service

# --- Grafana (local only) ----------------------------------------------------
# Local dashboards on a laptop. Not a secret worth protecting, but it lives
# here rather than in a tracked file so the pattern stays correct.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Hugging Face deployment (Phase 7) ---------------------------------------
# Write-scoped token. Set as a GitHub Actions secret, never committed.
# HF_TOKEN=
# HF_SPACE_ID=your-username/readmission-risk-api
# HF_MODEL_REPO=your-username/readmission-risk-model
