# =============================================================================
# NEVER COMMIT — health-adjacent project. Verified by hand before first push.
# See docs/DECISIONS/ and README "Data handling" for the reasoning.
# =============================================================================

# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*_credentials.json
.secrets.baseline.local

# --- Patient-level data ------------------------------------------------------
# The UCI dataset is public, but we still never commit row-level records:
# it keeps the repo honest, small, and reviewable. data/README.md explains
# how to fetch it; data/checksums.txt makes that fetch reproducible.
data/raw/
data/interim/
data/processed/
data/reference/
data/monitoring/
*.csv
*.parquet
*.feather
*.arrow
*.xlsx
!data/checksums.txt

# --- Model binaries ----------------------------------------------------------
# Models live in the MLflow registry (local) and an HF Model repo (remote),
# never in git. Binaries in git make clones huge and diffs meaningless.
#
# Root-anchored: an unanchored `models/` would also match the source package
# src/mlservice/models/, silently excluding the training code from the repo.
/models/
*.pkl
*.pickle
*.joblib
*.onnx
*.bin
*.pt
*.h5

# --- MLflow ------------------------------------------------------------------
mlruns/
mlartifacts/
mlflow.db
*.mlflow

# --- Observability volumes ---------------------------------------------------
grafana-data/
prometheus-data/
alertmanager-data/
postgres-data/

# --- Monitoring output -------------------------------------------------------
reports/*.html
reports/*.json

# The promotion history is an append-only audit trail of what was deployed when.
# It is real operational state, not source: it grows on every promote, rollback
# and rollback-path verification, and merging two machines' histories would be
# meaningless. The verified rollback cycle is quoted in docs/RETRAINING_POLICY.md
# instead, where it can be read without replaying the file.
reports/*.ndjson

!reports/.gitkeep

# Exception: the data audit is aggregate statistics only — no row-level records,
# longest array is 20 elements, 11 KB. It is the provenance for
# docs/DATA_AUDIT.md, so committing it lets a reviewer check the document's
# prose against the numbers the code actually produced.
!reports/data_audit.json

# Same exception, same reasoning: aggregate metrics only (30 KB, no
# row-level records). It is the provenance for docs/MODEL_CARD.md, so
# committing it lets a reviewer check the card against the run.
!reports/training_summary.json

# Same exception again. null_calibration.json is the EVIDENCE that the drift
# thresholds were derived rather than invented — it holds the full null
# distribution per feature, not just the chosen value. The replay reports
# carry the drift_origin labelling that makes the induced-drift demo honest.
# All three are aggregate statistics; none contain row-level records.
!reports/null_calibration.json
!reports/replay_real.json
!reports/replay_induced_age.json

