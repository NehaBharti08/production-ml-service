# =============================================================================
# API image — multi-stage.
#
# Two properties this build is optimised for, in order:
#   1. A small, reviewable attack surface. CI gates on a Trivy scan failing at
#      HIGH/CRITICAL, and every package not installed is a package that cannot
#      be a finding.
#   2. Reproducibility. uv installs from the committed uv.lock, so the image
#      resolves to identical versions on every build.
#
# Only the `serve` dependency group is installed. Training and monitoring
# dependencies (mlflow, evidently, matplotlib) do not belong in a serving image.
# =============================================================================

# --- Builder -----------------------------------------------------------------
FROM python:3.11-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependencies first, in their own layer: they change far less often than
# source, so this layer survives most rebuilds.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-install-project --no-dev --group serve

# Then the project itself.
COPY src/ ./src/
RUN uv sync --locked --no-dev --group serve

# Strip build tooling from the venv.
#
# Not cosmetic. The Trivy gate caught two real HIGH CVEs on the first run that
# ever built this image, and neither package is used to serve anything:
#
#   jaraco.context 5.3.0   CVE-2026-23949  path traversal via malicious tar
#   wheel          0.45.1  CVE-2026-24049  privilege escalation via bad wheel
#
# Removing them eliminates the finding outright, which is better than pinning
# newer versions of packages this service never calls. It is the concrete form
# of the principle at the top of this file.
RUN SITE=$(/app/.venv/bin/python -c "import sysconfig; print(sysconfig.get_paths()['purelib'])") \
    && rm -rf \
        "$SITE"/setuptools "$SITE"/setuptools-*.dist-info \
        "$SITE"/pkg_resources \
        "$SITE"/wheel "$SITE"/wheel-*.dist-info \
        "$SITE"/jaraco* \
        "$SITE"/_distutils_hack "$SITE"/distutils-precedence.pth \
        "$SITE"/pip "$SITE"/pip-*.dist-info \
    && /app/.venv/bin/python -c "import fastapi, sklearn, pandas; print('venv imports OK')"


# --- Runtime -----------------------------------------------------------------
FROM python:3.11-slim-bookworm AS runtime

# Non-root. A container that does not need root should not have it, and the
# Kubernetes manifests in Phase 7 set runAsNonRoot to enforce this at admission.
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --shell /bin/bash --create-home app

# Strip build tooling from the BASE IMAGE's Python too.
#
# The first attempt purged only /app/.venv and the scan still failed. The CVEs
# were in /usr/local/lib/python3.11/site-packages: python:3.11-slim ships its
# own setuptools (which vendors jaraco.context) and wheel. The venv has its own
# site-packages, so the base copies were pure attack surface — present, scanned,
# and never imported.
#
# The stdlib is untouched; only these packages are removed. Done before the venv
# is copied so a failure here cannot be mistaken for a venv problem.
RUN SITE=$(python -c "import sysconfig; print(sysconfig.get_paths()['purelib'])") \
    && rm -rf \
        "$SITE"/setuptools "$SITE"/setuptools-*.dist-info \
        "$SITE"/pkg_resources \
        "$SITE"/wheel "$SITE"/wheel-*.dist-info \
        "$SITE"/jaraco* \
        "$SITE"/_distutils_hack "$SITE"/distutils-precedence.pth \
        "$SITE"/pip "$SITE"/pip-*.dist-info

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MLSERVICE_ENV=local \
    MLSERVICE_LOGGING__FORMAT=json

WORKDIR /app

COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app src/     ./src/
COPY --chown=app:app configs/ ./configs/
COPY --chown=app:app ui/      ./ui/

# Prove the purge did not break the runtime. Without this the image would build
# fine and fail on the first request instead.
RUN /app/.venv/bin/python -c \
    "import fastapi, uvicorn, sklearn, pandas, mlservice; print('runtime imports OK')"

# Written to at runtime: the prediction log lands here.
RUN mkdir -p /app/data/monitoring /app/logs && chown -R app:app /app/data /app/logs

USER app

EXPOSE 8000

# Readiness, not liveness — this must report unhealthy while the model is
# unloaded. Orchestrators use it to hold traffic back rather than to restart.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health/ready').status==200 else 1)"

# exec form, so uvicorn is PID 1 and receives SIGTERM directly. Wrapped in a
# shell it would not, in-flight requests would be dropped, and the graceful
# shutdown would silently never run. Verified in CI by docker stop asserting the
# service_stopping log line appears.
CMD ["uvicorn", "mlservice.api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--timeout-graceful-shutdown", "20", \
     "--no-access-log"]
